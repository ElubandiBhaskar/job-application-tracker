# Copy this file to .env and adjust. .env is git-ignored.

# --- Django ---
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True only when the site is served over https (turns on secure cookies, HSTS, redirect)
DJANGO_HTTPS=False

# --- PostgreSQL ---
DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=jobtracker
DB_HOST=localhost
DB_PORT=5432
# DB_ENGINE=sqlite   # only if you have no Postgres handy (tests / quick look)

# --- Auth ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
AUTH_THROTTLE_RATE=20/min

# --- CORS (only matters if the frontend is served from a different origin than the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
